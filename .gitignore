# Large Model & Raw Pickle Files (>100MB)
*.pkl
*.pickle
*.joblib
*.h5
*.onnx
*.bin

# Allow compressed model (24MB, well under GitHub 100MB limit)
!model.pkl.gz

# Large Data files
*.csv
*.tsv
*.zip
*.tar.gz
*.parquet

# OS generated files
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml
